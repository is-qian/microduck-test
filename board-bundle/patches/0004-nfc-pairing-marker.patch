 /// The first Bluetooth address in these records, as `AA:BB:CC:DD:EE:FF`.
 ///
+/// What a tag asks the robot to pair.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum PairRequest {
+    /// The pad at this Bluetooth address.
+    Address(String),
+    /// The pad in pairing mode advertising this name — what the fixed marker asks for.
+    Name(String),
+}
+
+/// The fixed text of a pairing tag that names no address: `microduck_gamepad_pairing`, alone or
+/// with the pad's advertised name after a colon. A bare marker asks for a Pro Controller, the
+/// pad this scheme exists for.
+pub const PAIRING_MARKER: &str = "microduck_gamepad_pairing";
+const MARKER_DEFAULT_NAME: &str = "Pro Controller";
+
+/// The pairing request a tag carries: an address when one is written in it, else the marker's.
+pub fn pair_request_in(records: &[Record]) -> Option<PairRequest> {
+    if let Some(mac) = mac_in(records) {
+        return Some(PairRequest::Address(mac));
+    }
+    records.iter().find_map(|record| {
+        let rest = record.value().trim().strip_prefix(PAIRING_MARKER)?;
+        match rest.strip_prefix(':') {
+            // `microduck_gamepad_pairing:8BitDo` pairs whatever name follows the colon.
+            Some(name) if !name.trim().is_empty() => {
+                Some(PairRequest::Name(name.trim().to_owned()))
+            }
+            Some(_) => None,
+            None if rest.is_empty() => Some(PairRequest::Name(MARKER_DEFAULT_NAME.to_owned())),
+            None => None,
+        }
+    })
+}
