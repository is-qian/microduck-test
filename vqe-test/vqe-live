#!/bin/sh
# usage: sudo vqe-live raw_out.wav vqe_out.wav [seconds]
# Realtime: capture facemic raw stream -> per-frame VQE (ANR+AGC) ->
# writes raw mono + processed mono wavs; prints per-second levels.
DIR=$(cd "$(dirname "$0")" && pwd)
[ "$(id -u)" = 0 ] || { echo "run with sudo"; exit 1; }
[ $# -ge 2 ] || { echo "usage: sudo vqe-live raw_out.wav vqe_out.wav [seconds]"; exit 1; }
DUR=${3:-10}
printf 'rockchip,rv1126b\0' > /tmp/.vqe-compat
mount --bind /tmp/.vqe-compat /proc/device-tree/compatible
trap 'umount /proc/device-tree/compatible' EXIT INT TERM
arecord -D hw:facemic,0 -f S32_LE -r 16000 -c 2 -d "$DUR" -t raw - 2>/dev/null \
	| LD_LIBRARY_PATH=$DIR $DIR/vqe_live "$1" "$2" "$DIR/config_mic.json"
